# DevForge 环境变量示例 —— 复制为 .env 使用（.env 已被 gitignore）
# 配置来源：复制 configs/default.example.json 为 configs/default.json
# 并填入自己的 LLM API key；环境变量用于覆盖/补充。

# LLM 服务
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 访问令牌（非空时前端需输入，ws 走 ?token= 查询参数）
AUTH_TOKEN=

# 服务端口
DEVFORGE_PORT=8000
